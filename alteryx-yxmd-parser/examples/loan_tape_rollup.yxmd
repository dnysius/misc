    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.AlteryxSelect.AlteryxSelect">
        <Position x="150" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <OrderChanged value="False" />
          <CommaDecimal value="False" />
          <SelectFields>
            <SelectField field="LoanID" selected="True" />
            <SelectField field="CustomerID" selected="True" />
            <SelectField field="Balance" selected="True" rename="OutstandingBalance" />
            <SelectField field="Rate" selected="True" type="FixedDecimal" size="19.6" />
            <SelectField field="Status" selected="True" />
            <SelectField field="OriginationDate" selected="False" />
            <SelectField field="*Unknown" selected="False" />
