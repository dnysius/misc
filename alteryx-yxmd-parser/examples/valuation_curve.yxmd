        <Field field="DealID" order="Ascending" /><Field field="Tenor" order="Ascending" />
      </SortInfo></Configuration></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSort" />
    </Node>
