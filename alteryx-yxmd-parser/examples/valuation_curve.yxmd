<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2022.3">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput"><Position x="50" y="50" /></GuiSettings>
      <Properties>
        <Configuration>
          <File OutputFileName="" RecordLimit="1000" FileFormat="24">odbc:DSN=ValuationsDW;UID=svc;PWD=s3cret|||SELECT DealID, AsOfDate, Tenor, Rate FROM dbo.Curves WHERE AsOfDate &gt;= '2026-01-01'</File>
        </Configuration>
        <MetaInfo connection="Output"><RecordInfo>
          <Field name="DealID" size="12" type="V_String" />
          <Field name="AsOfDate" size="10" type="Date" />
          <Field name="Tenor" size="4" type="Int32" />
          <Field name="Rate" size="8" type="Double" />
        </RecordInfo></MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
